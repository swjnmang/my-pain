rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Globaler Übungskatalog & Trainingsvorlagen: für alle eingeloggten
    // Nutzer lesbar, Schreiben nur über das Seed-Script (Admin SDK).
    match /exercises/{exerciseId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /workoutTemplates/{templateId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Profil-Dokument des Nutzers selbst (Körpergröße/Gewicht).
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Nutzerdaten (Subcollections): nur der jeweilige Nutzer darf lesen/schreiben.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
